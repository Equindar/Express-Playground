{
  "name": "express-playground",
  "version": "1.0.0",
  "description": "Just messing around with Express and Typescript",
  "main": "index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --cache --check .",
    "start": "node build/server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Equindar/Express-Playground.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Equindar/Express-Playground/issues"
  },
  "homepage": "https://github.com/Equindar/Express-Playground#readme",
  "dependencies": {
    "@libsql/client": "^0.15.7",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "prettier": "^3.3.3",
    "express": "^5.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.1",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}